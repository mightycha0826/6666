# Gemini API key — obtain from https://aistudio.google.com/app/apikey
#
# IMPORTANT: Copy this file to `.env.local` (do not edit .env.example directly),
# then restart `npm run dev` after setting a value. Values in .env.local are
# read at build/boot time only.
#
# ─────────────────────────────────────────────────────────────────────────
# REQUIRED for the current boilerplate (client-side calls to Gemini):
# The chat and document analyzer run inside "use client" components, so
# the key must be exposed to the browser via the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_GEMINI_API_KEY=
#
# OPTIONAL (recommended for production):
# If you move the Gemini calls behind a Next.js Route Handler / Server
# Action, keep the key server-only by using this variable instead and
# remove NEXT_PUBLIC_GEMINI_API_KEY from this file.
# GEMINI_API_KEY=
